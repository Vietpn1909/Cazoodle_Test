# Copy to .env and adjust. Never commit .env.

# --- Database (docker compose `db` service) ---
POSTGRES_USER=uiuc
POSTGRES_PASSWORD=uiuc
POSTGRES_DB=uiuc_research
POSTGRES_PORT=5432
# Single driver (psycopg 3) used for sync (pipeline, alembic) and async (API)
DATABASE_URL=postgresql+psycopg://uiuc:uiuc@localhost:5432/uiuc_research

# --- OpenAlex ---
# Optional but recommended: free key at https://openalex.org/settings/api ($1/day budget vs $0.10/day shared)
OPENALEX_API_KEY=
OPENALEX_INSTITUTION_ID=I157725225

# --- Snapshot window (fixed for reproducibility, see ADR-007) ---
SNAPSHOT_DATE=2026-11-16
WINDOW_YEARS=2

# --- Retrieval ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- LLM (provider not chosen yet, see ADR-004) ---
# none = deterministic router + templated answers, no key required
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# --- API ---
API_CORS_ORIGINS=http://localhost:3000
